# ============================================================
# Prospection IA — variables d'environnement
# Copiez ce fichier en `.env` à la racine puis remplissez-le.
# Le process REFUSE de démarrer si une variable requise manque
# (validation Zod avec message explicite).
# ============================================================

# --- Base de données (docker compose up -d fournit ce Postgres) ---
DATABASE_URL=postgres://prospection:prospection@localhost:5432/prospection

# --- Auth (Better Auth) ---
# Générez un secret aléatoire : `openssl rand -base64 32`
AUTH_SECRET=
# URL de base de l'application web (locale par défaut)
APP_BASE_URL=http://localhost:3000

# --- Fuseau horaire de référence (fenêtres d'envoi, quotas journaliers) ---
TZ=Europe/Paris

# --- IA ---
# Fournisseur : anthropic (OpenAI/Gemini/Ollama : stubs documentés, V2)
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=

# --- Google (chaque clé est optionnelle : la source correspondante
#     est simplement indisponible si la clé manque) ---
# Places API (New) — découverte d'entreprises locales
GOOGLE_MAPS_API_KEY=
# YouTube Data API v3 — découverte de chaînes
YOUTUBE_API_KEY=
# Programmable Search JSON API — index Google des profils sociaux publics
GOOGLE_CSE_API_KEY=
# Identifiants des 3 moteurs de recherche personnalisés (un par plateforme,
# restreints respectivement à instagram.com / tiktok.com / facebook.com)
GOOGLE_CSE_CX_INSTAGRAM=
GOOGLE_CSE_CX_TIKTOK=
GOOGLE_CSE_CX_FACEBOOK=

# --- Email (connecteur SMTP/IMAP universel) ---
# ⚠️ Gmail gratuit (mot de passe d'application) = TESTS UNIQUEMENT.
#    Pour la prospection réelle : domaine dédié + Zoho Mail Lite (voir README §4).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
# Identité expéditeur (affichée dans chaque email — obligation d'identification)
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=

# --- Désinscription one-click (optionnel, uniquement si déploiement VPS
#     avec URL publique ; en local l'opt-out = réponse STOP) ---
UNSUBSCRIBE_PUBLIC_URL=
